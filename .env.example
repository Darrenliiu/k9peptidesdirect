# Neon Postgres (pooled URL for the app; Vercel Marketplace Neon is preferred)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production only. Leave unset on Preview so each preview URL works.
BETTER_AUTH_URL=https://k9peptidesdirect.com

# Comma-separated admin emails. No passwords are hard-coded.
ADMIN_EMAILS=you@example.com

# stub (default, no card data) | stripe
PAYMENT_PROVIDER=stub

# Stripe — test-mode keys only. Never commit live secrets.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional order-notification email (Resend). If unset, notifications are logged.
# RESEND_API_KEY=
# ORDER_NOTIFICATION_EMAIL=orders@example.com

# Newsletter (from #1). Vercel Blob store + export token — already set on the project.
# BLOB_READ_WRITE_TOKEN=
# SUBSCRIBERS_EXPORT_TOKEN=
